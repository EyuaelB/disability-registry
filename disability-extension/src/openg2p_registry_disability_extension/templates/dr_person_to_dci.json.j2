      "@type": "dr:DisabilitySupport",
      "human_assistance": {% if human %}{{ human_row(human[0]) }}{% else %}null{% endif %},
      "assistive_technology": [
        {%- for row in assistive -%}
        {{ support_row(row, 'ASSISTIVE_TECHNOLOGY_TYPE', 'assistive_technology_type', 'dr:AssistiveTechnology') }}{% if not loop.last %},{% endif %}
        {%- endfor -%}
      ],
      "housing_support": [
        {%- for row in housing -%}
        {{ support_row(row, 'HOUSING_SUPPORT_TYPE', 'housing_support_type', 'dr:HousingSupport') }}{% if not loop.last %},{% endif %}
        {%- endfor -%}
      ],
      "medical_care": [
        {%- for row in medical -%}
        {{ support_row(row, 'MEDICAL_CARE_TYPE', 'medical_care_type', 'dr:MedicalCare') }}{% if not loop.last %},{% endif %}
        {%- endfor -%}
      ],
      "animal_assistance": [
        {%- for row in animal -%}
        {{ support_row(row, 'ANIMAL_ASSISTANCE_TYPE', 'animal_assistance_type', 'dr:AnimalAssistance') }}{% if not loop.last %},{% endif %}
        {%- endfor -%}
      ],
      "registration_date": {{ registered | tojson }},
      "last_updated": {{ updated | tojson }}
    }
    {%- for row in human[1:] -%},
    {
      "@type": "dr:DisabilitySupport",
      "human_assistance": {{ human_row(row) }},
      "assistive_technology": [],
      "housing_support": [],
      "medical_care": [],
      "animal_assistance": [],
      "registration_date": {{ dt(row.get('registration_date')) | tojson }},
      "last_updated": {{ dt(row.get('last_updated')) | tojson }}
    }
    {%- endfor -%}
  ],
  "transport_requirement": {{ cw('TRANSPORT_REQUIREMENT', p.get('transport_requirement')) | tojson }},
  "housing_type": {{ cw('HOUSING_TYPE', p.get('housing_type')) | tojson }},
  "programs_enrolments": [
    {%- for row in programs -%}
    {
      "@type": "ProgramEnrolment",
      "program_name": {{ (row.get('program_name') or '') | tojson }},
      "program_identifier": {{ (row.get('program_identifier') or '') | tojson }},
      "enrolment_status": {{ (row.get('enrolment_status') or '') | string | trim | lower | replace('_', ' ') | tojson }},
      "enrolment_start_date": {{ dt(row.get('enrolment_start_date')) | tojson }},
      "enrolment_end_date": {{ dt(row.get('enrolment_end_date')) | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "registration_date": {{ registered | tojson }},
  "last_updated": {{ updated | tojson }}
}
