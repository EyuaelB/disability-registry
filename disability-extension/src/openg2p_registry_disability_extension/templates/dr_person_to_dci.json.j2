{%- macro cw(list, value) -%}
{{- DCI_OUT[list].get((value or '') | string | trim | upper, '') -}}
{%- endmacro -%}
{# DF.COM.STRING.01 date_time: a stored date becomes midnight UTC; a stored
   timestamp is passed through; empty stays empty. #}
{%- macro dt(value) -%}
{%- set s = (value | string | trim) if value is not none else '' -%}
{%- if not s -%}
{%- elif 'T' in s -%}{{ s }}
{%- elif ' ' in s -%}{{ s | replace(' ', 'T') }}
{%- else -%}{{ s }}T00:00:00Z
{%- endif -%}
{%- endmacro -%}
{# CD.DR.14 from the stored outcome. EXPIRED is explicit; see the header note. #}
{%- macro status_cd(value) -%}
{{- cw('DISABILITY_STATUS', value) -}}
{%- endmacro -%}
{# CD.DR.07 life stage from the band, else from the integer age. #}
{%- macro onset_cd(band, age) -%}
{%- set b = cw('AGE_ONSET', band) -%}
{%- if b -%}{{ b }}
{%- elif age is not none and (age | string | trim) -%}
  {%- set a = age | int(-1) -%}
  {%- if a == 0 -%}Born with
  {%- elif 0 < a < 18 -%}Childhood
  {%- elif 18 <= a < 60 -%}Working age
  {%- elif a >= 60 -%}Old age
  {%- endif -%}
{%- endif -%}
{%- endmacro -%}
{# Contacts: G2PPerson stores phone_numbers/emails as JSONB, which senders have
   variously produced as a list of strings, a list of objects, or a stringified
   list. Flattened into a real list here. #}
{%- macro contact_append_from_raw(raw, target) -%}
{%- if raw is string -%}
  {%- set t = raw | trim -%}
  {%- if t | length >= 2 and t[0:1] == '[' and t[-1:] == ']' -%}
    {%- set inner = t[1:-1] | trim -%}
    {%- if inner -%}
      {%- set flat = inner | replace("'", '') | replace('"', '') -%}
      {%- for part in flat.split(',') -%}
        {%- set piece = part | trim -%}
        {%- if piece -%}{%- set _ = target.append(piece) -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- elif t -%}
    {%- set _ = target.append(t) -%}
  {%- endif -%}
{%- elif raw is mapping -%}
  {%- set n = raw.get('number') or raw.get('phone_number') or raw.get('email') or raw.get('value') -%}
  {%- if n -%}{%- set _ = target.append(n | string | trim) -%}{%- endif -%}
{%- elif raw is iterable -%}
  {%- for item in raw -%}
    {%- if item is string -%}
      {%- if item | trim -%}{%- set _ = target.append(item | trim) -%}{%- endif -%}
    {%- elif item is mapping -%}
      {%- set n = item.get('number') or item.get('phone_number') or item.get('email') or item.get('value') -%}
      {%- if n -%}{%- set _ = target.append(n | string | trim) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- macro support_row(row, type_list, type_field, jsonld_type) -%}
{
  "@type": {{ jsonld_type | tojson }},
  "type": {{ cw(type_list, row.get(type_field)) | tojson }},
  "support_status": {{ cw('SUPPORT_STATUS', row.get('support_status')) | tojson }},
  "registration_date": {{ dt(row.get('registration_date')) | tojson }},
  "last_updated": {{ dt(row.get('last_updated')) | tojson }}
}
{%- endmacro -%}
{%- macro human_row(row) -%}
{
  "@type": "dr:HumanAssistance",
  "type": {{ cw('HUMAN_ASSISTANCE_TYPE', row.get('assistance_type')) | tojson }},
  "frequency": {{ cw('SUPPORT_FREQUENCY', row.get('frequency')) | tojson }},
  "support_status": {{ cw('SUPPORT_STATUS', row.get('support_status')) | tojson }},
  "caregiver": {
    "@type": "Person",
    "name": {{ (row.get('caregiver_name') or '') | tojson }},
    "identifier": {{ (row.get('caregiver_identifier') or '') | tojson }}
  },
  "relationship": {{ cw('CAREGIVER_RELATIONSHIP', row.get('caregiver_relationship')) | tojson }},
  "registration_date": {{ dt(row.get('registration_date')) | tojson }},
  "last_updated": {{ dt(row.get('last_updated')) | tojson }}
}
{%- endmacro -%}
