  "birth_date": {{ d(demo.get('birth_date')) | tojson }},
  "death_date": {{ d(demo.get('death_date')) | tojson }},
  "marital_status": {{ (norm(member.get('marital_status')) if norm(member.get('marital_status')) in ['SINGLE', 'MARRIED', 'DIVORCED', 'WIDOWED', 'SEPARATED'] else 'UNKNOWN') | tojson }},
  "occupation": {{ (member.get('occupation') or '') | string | trim | tojson }},
