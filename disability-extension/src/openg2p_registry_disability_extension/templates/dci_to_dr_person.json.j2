      "postal_code": {{ (address.get('postal_code') if address is mapping else '') | default('', true) | string | tojson }},
      "country_code": {{ (address.get('country_code') if address is mapping else '') | default('', true) | string | tojson }}
    }
  ],
  "disability_status_and_assessment": [
    {
      "self_id_disability": {{ self_id_bool(member.get('self_id_disability')) }},
      "disability_status": {{ cw('DISABILITY_STATUS', rec.get('disability_status')) | tojson }},
      "disability_status_level": {{ cw('DISABILITY_STATUS_LEVEL', rec.get('disability_status_level')) | tojson }},
      "assessment_date": {{ d(a.get('assessment_date')) | tojson }},
      "assessment_authority": {{ (a.get('assessment_authority') or '') | string | tojson }},
      "certificate_issue_date": {{ d(a.get('certificate_issue_date')) | tojson }},
      "certificate_expiry_date": {{ d(a.get('certificate_expiry_date')) | tojson }}
    }
  ],
  "living_situation": [
    {
      "housing_type": {{ cw('HOUSING_TYPE', rec.get('housing_type')) | tojson }},
      "transport_requirement": {{ cw('TRANSPORT_REQUIREMENT', rec.get('transport_requirement')) | tojson }},
      "legal_capacity_status": {{ norm(a.get('legal_capacity_status')) | tojson }}
    }
  ],
  "socio_economic_profile": [
    {
      "employment_status": {{ norm(member.get('employment_status')) | tojson }}
    }
  ],
  "disability_details": [
    {%- for row in details -%}
    {%- set extra = (row.get('additional_attributes') or [{}]) -%}
    {%- set extra0 = (extra | first) if extra is iterable and extra is not mapping and extra is not string and extra else (extra if extra is mapping else {}) -%}
    {
      "impairment_type": {{ cw('IMPAIRMENT_TYPE', row.get('impairment_type')) | tojson }},
      "impairment_level": {{ cw('IMPAIRMENT_LEVEL', row.get('impairment_level')) | tojson }},
      "impairment_cause": {{ cw('IMPAIRMENT_CAUSE', row.get('impairment_cause')) | tojson }},
      "age_onset_band": {{ onset_band(row.get('age_on_set')) | tojson }},
      "age_on_set": {% if extra0 is mapping and extra0.get('age_on_set_years') is not none %}{{ extra0.get('age_on_set_years') | int }}{% else %}{{ onset_years(row.get('age_on_set')) }}{% endif %},
      "is_primary_impairment": {% if extra0 is mapping and 'is_primary_impairment' in extra0 %}{{ 'true' if extra0.get('is_primary_impairment') else 'false' }}{% elif loop.first %}true{% else %}false{% endif %}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "human_assistance": [
    {%- for row in human -%}
    {%- set cg = row.get('caregiver') -%}
    {
      "assistance_type": {{ cw('HUMAN_ASSISTANCE_TYPE', row.get('type')) | tojson }},
      "frequency": {{ cw('SUPPORT_FREQUENCY', row.get('frequency')) | tojson }},
      "support_status": {{ cw('SUPPORT_STATUS', row.get('support_status')) | tojson }},
      "caregiver_name": {{ ((cg.get('name') if cg is mapping else cg) or '') | string | tojson }},
      "caregiver_identifier": {{ ((cg.get('identifier') if cg is mapping else '') or '') | string | tojson }},
      "caregiver_relationship": {{ cw('CAREGIVER_RELATIONSHIP', row.get('relationship')) | tojson }},
      "registration_date": {{ d(row.get('registration_date')) | tojson }},
      "last_updated": {{ d(row.get('last_updated')) | tojson }}
