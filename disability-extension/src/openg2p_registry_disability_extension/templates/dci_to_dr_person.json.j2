      "related_person_birth_date": {{ d(rm.get('birth_date') if rm is mapping else '') | tojson }},
      "is_primary_caregiver": {% if (rextra0 is mapping and rextra0.get('is_primary_caregiver')) or row.get('is_primary_caregiver') %}true{% else %}false{% endif %},
