{# END GENERATED DCI CROSSWALK #}
{# Mirrors dci_crosswalk.normalise: upper case, separators to '_', punctuation
   dropped. Jinja has no regex filter, so the punctuation the standard's labels
   actually contain is listed; anything stranger simply fails to match and falls
   back, which is the safe direction. #}
{%- macro norm(v) -%}
{{- (v if v is not none else '') | string | trim | upper | replace('-', '_') | replace(' ', '_') | replace('/', '_')
    | replace(',', '') | replace('.', '') | replace('(', '') | replace(')', '') | replace("'", '') | replace('"', '')
    | replace(':', '') | replace(';', '') | replace('&', '') | replace('+', '') | replace('*', '') | replace('!', '')
    | replace('?', '') | replace('[', '') | replace(']', '') -}}
{%- endmacro -%}
{%- macro cw(list, v) -%}
{%- set k = norm(v) -%}
{%- if not k -%}
{%- elif k in DCI_IN[list] -%}{{ DCI_IN[list][k] }}
{%- else -%}{{ DCI_FALLBACK[list] }}
{%- endif -%}
{%- endmacro -%}
{# DF.COM.STRING.01 date_time -> registry date column (YYYY-MM-DD). #}
{%- macro d(v) -%}
{%- set s = (v | string | trim) if v is not none else '' -%}
{{- s[:10] if s | length >= 10 else s -}}
{%- endmacro -%}
{# CD.DR.07 life stage (or a legacy integer age) -> age_onset_band. #}
{%- macro onset_band(v) -%}
{%- set s = (v | string | trim) if v is not none else '' -%}
{%- if not s -%}
{%- elif s.isdigit() and (s | int) > 3 -%}
  {%- set a = s | int -%}
  {%- if a == 0 -%}AT_BIRTH{%- elif a <= 5 -%}EARLY_CHILDHOOD_0_5{%- elif a <= 12 -%}CHILDHOOD_6_12{%- elif a <= 17 -%}ADOLESCENCE_13_17{%- elif a <= 59 -%}ADULTHOOD_18_59{%- else -%}OLD_AGE_60_PLUS{%- endif -%}
{%- else -%}{{ cw('AGE_ONSET', s) }}
{%- endif -%}
{%- endmacro -%}
{# Integer age only when the sender actually sent a number (the standard sends a
   life stage; a numeric code 0-3 is a code, not an age). #}
{%- macro onset_years(v) -%}
{%- set s = (v | string | trim) if v is not none else '' -%}
{%- if s.isdigit() and (s | int) > 3 -%}{{ s | int }}{%- else -%}null{%- endif -%}
{%- endmacro -%}
{# yes(1)/no(0) per DO.DR.02. Anything unrecognised stays null: "not stated" and
   "states they are not disabled" are different answers. #}
{%- macro self_id_bool(v) -%}
{%- set s = norm(v) -%}
{%- if s in ['1', 'TRUE', 'YES', 'Y'] -%}true
{%- elif s in ['0', 'FALSE', 'NO', 'N'] -%}false
{%- else -%}null
{%- endif -%}
{%- endmacro -%}
{%- macro first_str(value) -%}
{%- if value is string -%}{{ value | trim }}
{%- elif value is mapping -%}{{ (value.get('number') or value.get('email') or value.get('value') or '') | string | trim }}
{%- elif value is iterable and value -%}
  {%- set item = value | first -%}
  {%- if item is string -%}{{ item | trim }}
  {%- elif item is mapping -%}{{ (item.get('number') or item.get('email') or item.get('value') or '') | string | trim }}
  {%- endif -%}
{%- endif -%}
{%- endmacro -%}
{%- set rec = expanded -%}
{# DO.DR.03.personal_details (standard) or the flat legacy layout. #}
{%- set member = rec.get('personal_details') if rec.get('personal_details') is mapping else rec -%}
{%- set demo = member.get('demographic_info') or {} -%}
{%- set name = demo.get('name') or {} -%}
{%- set addl_raw = member.get('additional_attributes') if member.get('additional_attributes') is not none else rec.get('additional_attributes') -%}
{%- set addl = namespace(map={}) -%}
{%- if addl_raw is mapping -%}
  {%- set addl.map = addl_raw -%}
{%- elif addl_raw is iterable and addl_raw is not string -%}
  {%- set merged = {} -%}
  {%- for item in addl_raw -%}
    {%- if item is mapping -%}{%- set _ = merged.update(item) -%}{%- endif -%}
  {%- endfor -%}
  {%- set addl.map = merged -%}
{%- endif -%}
{%- set a = addl.map -%}
{# disability_support: object or list of objects; flatten every sub-list. #}
{%- set support_raw = rec.get('disability_support') -%}
{%- set supports = (support_raw if support_raw is iterable and support_raw is not mapping and support_raw is not string else ([support_raw] if support_raw is mapping else [])) -%}
{%- set human = [] -%}{%- set assistive = [] -%}{%- set medical = [] -%}{%- set housing = [] -%}{%- set animal = [] -%}
{%- for s in supports -%}
  {%- if s is mapping -%}
    {%- set h = s.get('human_assistance') -%}
    {%- if h is mapping -%}{%- set _ = human.append(h) -%}
    {%- elif h is iterable and h is not string -%}{%- for x in h -%}{%- if x is mapping -%}{%- set _ = human.append(x) -%}{%- endif -%}{%- endfor -%}{%- endif -%}
    {%- for key, target in [('assistive_technology', assistive), ('medical_care', medical), ('housing_support', housing), ('animal_assistance', animal)] -%}
      {%- set v = s.get(key) -%}
      {%- if v is mapping -%}{%- set _ = target.append(v) -%}
      {%- elif v is iterable and v is not string -%}{%- for x in v -%}{%- if x is mapping -%}{%- set _ = target.append(x) -%}{%- endif -%}{%- endfor -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{%- set details = rec.get('disability_details') or [] -%}
{%- set relatives = member.get('related_person') or rec.get('related_person') or [] -%}
{%- set programs = rec.get('programs_enrolments') or rec.get('programs_enrollments') or [] -%}
{# Identifiers: CD.COM.01 UIN is the national id. Legacy senders put the
   registry's own number under UIN and the national id under NationalID; both
   are read so nothing already connected breaks. #}
{%- set nid = namespace(explicit='', uin='') -%}
{%- for source in [member.get('member_identifier'), demo.get('identifier')] -%}
  {%- if source is iterable and source is not string and source is not mapping -%}
    {%- for identifier in source -%}
      {%- if identifier is mapping -%}
        {%- set t = norm(identifier.get('identifier_type')) -%}
        {%- set v = (identifier.get('identifier_value') or '') | string | trim -%}
        {%- if v and not nid.explicit and t in ['NATIONALID', 'NATIONAL_ID', 'FOUNDATIONAL_ID'] -%}
          {%- set nid.explicit = v -%}
        {%- elif v and not nid.uin and t == 'UIN' -%}
          {%- set nid.uin = v -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{# An explicit NationalID (legacy senders) beats UIN, because those senders put
   the registry's own number under UIN. #}
{%- set national_id = nid.explicit or nid.uin -%}
{%- set address = (demo.get('address') or [{}]) | first -%}
{%- set phone = first_str(demo.get('phone_number')) -%}
{%- set email = first_str(demo.get('email')) -%}
{%- set langs_raw = member.get('language_code') -%}
{
  "first_name": {{ (name.get('given_name') or '') | tojson }},
  "middle_name": {{ (name.get('second_name') or '') | tojson }},
