      "last_updated": {{ d(row.get('last_updated')) | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ],
  "related_persons": [
    {%- for row in relatives -%}
    {%- set rm = row.get('related_member') or {} -%}
